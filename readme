# Resolver permissões (primeira vez)
sudo usermod -aG docker $USER
newgrp docker

# Entrar na pasta
cd /home/fango/ServicoMail

# Ligar Docker com Mailpit
docker-compose up -d

# Instalar Nodemailer
npm install nodemailer

# Enviar email de teste
node servico_email.js

# Verificar emails em: http://localhost:8025